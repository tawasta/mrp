<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mgmtsystem_hazard_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.hazard.tree.residual.risk.number</field>
        <field name="model">mgmtsystem.hazard</field>
        <field
            name="inherit_id"
            ref="mgmtsystem_hazard_risk.view_mgmtsystem_hazard_tree"
        />
        <field name="arch" type="xml">
            <field name="risk" position="after">
                <field name="residual_risk_numbers" />
            </field>
        </field>
    </record>
</odoo>
