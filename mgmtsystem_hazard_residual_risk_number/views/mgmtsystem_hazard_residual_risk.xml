<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mgmtsystem_hazard_residual_risk_form" model="ir.ui.view">
        <field name="name">mgmtsystem.hazard.residual_risk.form.risk.number</field>
        <field name="model">mgmtsystem.hazard.residual_risk</field>
        <field
            name="inherit_id"
            ref="mgmtsystem_hazard_risk.view_mgmtsystem_hazard_residual_risk_form"
        />
        <field name="arch" type="xml">
            <field name="usage_id" position="after">
                <field name="risk_number" />
            </field>
        </field>
    </record>

    <record id="view_mgmtsystem_hazard_residual_risk_tree" model="ir.ui.view">
        <field name="name">mgmtsystem.hazard.residual_risk.tree.risk.number</field>
        <field name="model">mgmtsystem.hazard.residual_risk</field>
        <field
            name="inherit_id"
            ref="mgmtsystem_hazard_risk.view_mgmtsystem_hazard_residual_risk_tree"
        />
        <field name="arch" type="xml">
            <field name="usage_id" position="after">
                <field name="risk_number" />
            </field>
        </field>
    </record>
</odoo>
