<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_download_bom_csv_template" model="ir.actions.act_url">
        <field name="name">Download CSV template</field>
        <field name="url">/mrp_bom_import_wizard/static/description/bom_import_template.csv</field>
        <field name="target">new</field>
    </record>

  <record id="mrp_bom_import_wizard_form" model="ir.ui.view">
    <field name="name">mrp.bom.import.wizard.form</field>
    <field name="model">mrp.bom.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Import Bill of Materials">
        <group>
          <field name="data_file" filename="filename"/>
          <field name="filename" invisible="1"/>
          <field name="create_missing_products"/>
          <field name="company_id"/>
          <field name="dry_run"/>
        </group>

        <!-- Download templates: 100% static links from /static -->
        <group string="Download templates">
          <div class="oe_button_box" name="template_links">
            <button type="action" name="%(action_download_bom_csv_template)d"
                    class="oe_stat_button" icon="fa-download">
              <div class="o_stat_info">
                <span class="o_stat_text">CSV template</span>
              </div>
            </button>
          </div>
          <p class="text-muted">
            Opens in a new tab. Save, fill rows, and upload the file above.
          </p>
        </group>

        <separator string="How it works"/>
        <p>
          Upload a CSV/XLSX file. Each row represents <b>one component line</b> of a BoM.
          Rows are grouped into a single BoM by:
          <code>(product_tmpl_id, code, type, product_qty)</code>.
        </p>

        <separator string="Required columns"/>
        <p>
          <code>product_tmpl_id, product_qty, code, type, line_product_id, line_product_qty</code>
        </p>

        <separator string="Optional columns"/>
        <p>
          <code>product_tmpl_name</code> (template display name),<br/>
          <code>product_tmpl_uom_id</code> (template's <i>uom_id</i> by ID),<br/>
          <code>line_product_name</code> (component product display name),<br/>
          <code>line_product_uom_id</code> (component product's <i>uom_id</i> by ID),<br/>
          <code>line_product_uom</code> (BoM line UoM by <b>name</b>; if empty, component's default UoM is used).
        </p>

        <separator string="Example"/>
        <div class="oe_inline">
          <table class="o_table o_inner_table">
            <thead>
              <tr>
                <th>product_tmpl_id</th><th>product_tmpl_name</th><th>product_tmpl_uom_id</th>
                <th>product_qty</th><th>code</th><th>type</th>
                <th>line_product_id</th><th>line_product_name</th><th>line_product_qty</th><th>line_product_uom</th><th>line_product_uom_id</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>FINISHED-001</td><td>My Finished Product</td><td>1</td>
                <td>1</td><td>KIT001</td><td>normal</td>
                <td>COMP-001</td><td>Component A</td><td>2</td><td></td><td>1</td>
              </tr>
              <tr>
                <td>FINISHED-001</td><td>My Finished Product</td><td>1</td>
                <td>1</td><td>KIT001</td><td>normal</td>
                <td>COMP-002</td><td>Component B</td><td>3</td><td>Units</td><td>1</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-muted">
          Tips: <br/>
          • Use unique <b>code</b> per BoM to avoid duplicates. <br/>
          • <b>type</b> must be <code>normal</code> or <code>phantom</code>. <br/>
          • Quantities must be positive numbers (components can be 0 if you use optional lines later). <br/>
          • <b>product_tmpl_uom_id</b> and <b>line_product_uom_id</b> set the product's own UoM (by ID). <br/>
          • <b>line_product_uom</b> sets the BoM line UoM by name; leave empty to use component's default.
        </p>

        <footer>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
          <button string="Validate/Import" type="object" name="action_import" class="btn-primary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_mrp_bom_import" model="ir.actions.act_window">
    <field name="name">Import BoM</field>
    <field name="res_model">mrp.bom.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="mrp_bom_import_wizard_form"/>
    <field name="target">new</field>
    <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
    <field name="binding_type">action</field>
  </record>

  <menuitem id="menu_mrp_bom_import"
            name="Import BoM"
            parent="mrp.menu_mrp_bom"
            action="action_mrp_bom_import"
            sequence="12"/>
</odoo>
