<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lca.value</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100" />
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='schedule_info']" position="before">
                <block title="LCA Excel: Seconds in a year" id="lca_value">
                    <setting id="time_in_year">
                        <field name="time_in_year" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
