<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="mrp_area_form" model="ir.ui.view">
		<field name="name">mrp.area.form.ignore.production</field>
		<field name="model">mrp.area</field>
		<field name="inherit_id" ref="mrp_multi_level.mrp_area_form" />
		<field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="ignore_production_orders" />
                <field name="ignore_purchase_orders" />
                <field name="ignore_sale_orders" />
		    </field>
		</field>
	</record>

    <record id="mrp_area_tree" model="ir.ui.view">
		<field name="name">mrp.area.tree.ignore.production</field>
		<field name="model">mrp.area</field>
		<field name="inherit_id" ref="mrp_multi_level.mrp_area_tree" />
		<field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="ignore_production_orders" />
                <field name="ignore_purchase_orders" />
                <field name="ignore_sale_orders" />
		    </field>
		</field>
	</record>
</odoo>
