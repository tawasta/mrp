<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="product_mrp_area_form" model="ir.ui.view">
		<field name="name">product.mrp.area.form.safety.stock.warning</field>
		<field name="model">product.mrp.area</field>
		<field name="inherit_id" ref="mrp_multi_level.product_mrp_area_form" />
		<field name="arch" type="xml">
            <xpath
                expr="//field[@name='location_proc_id']/..//field[last()]"
                position="after"
            >
                <field name="safety_stock_warning" />
                <div attrs="{'invisible': [('safety_stock_warning', '=', False)]}">
                    <p style="color: brown;">
                        Quantity Available is lower than Safety Stock of this product.
                        Check its procurements.
                    </p>
		        </div>
		    </xpath>
		</field>
	</record>

    <record id="product_mrp_area_tree" model="ir.ui.view">
        <field name="name">product.mrp.area.tree.safety_stock</field>
        <field name="model">product.mrp.area</field>
        <field name="inherit_id" ref="mrp_multi_level.product_mrp_area_tree" />
        <field name="arch" type="xml">
            <field name="mrp_nbr_days" position="after">
                <field name="safety_stock_warning" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
