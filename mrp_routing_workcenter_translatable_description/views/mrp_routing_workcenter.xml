<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="mrp_routing_workcenter_form_view" model="ir.ui.view">
    <field name="name">mrp.routing.workcenter.form.description</field>
    <field name="model">mrp.routing.workcenter</field>
    <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='description']/.." position="after">
        <notebook>
          <page string="Description" name="worksheet">
            <field
              name="note"
              nolabel="1"
              placeholder="Description of the operation..."
            />
          </page>
        </notebook>
      </xpath>
    </field>
  </record>
</odoo>
