#. module: quality_control_oca_inspection_email
#: model:mail.template,body_html:quality_control_oca_inspection_email.mail_template_qc_inspection
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"        <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"            Hello,\n"
"            <br/><br/>\n"
"            Please find attached the inspection results for\n"
"            <t t-out=\"object.name or ''\">INS/00001</t>.\n"
"            <br/><br/>\n"
"            Best regards,\n"
