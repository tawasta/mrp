<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="qc_test_form_view" model="ir.ui.view">
    <field name="name">qc.test.form.inherit.freetext</field>
    <field name="model">qc.test</field>
    <field name="inherit_id" ref="quality_control_oca.qc_test_form_view" />
    <field name="arch" type="xml">
      <!-- Conditionally hide some values that are unneeded both when
     dealing with a qualitative or a freetext question -->
      <xpath
        expr="//field[@name='test_lines']//field[@name='min_value']"
        position="attributes"
      >
        <attribute name="invisible" add="type == 'freetext'" separator="or" />
      </xpath>

      <xpath
        expr="//field[@name='test_lines']//field[@name='max_value']"
        position="attributes"
      >
        <attribute name="invisible" add="type == 'freetext'" separator="or" />
      </xpath>

      <xpath
        expr="//field[@name='test_lines']//field[@name='uom_id']"
        position="attributes"
      >
        <attribute name="invisible" add="type == 'freetext'" separator="or" />
      </xpath>

      <xpath
        expr="//field[@name='test_lines']//field[@name='ql_values']"
        position="attributes"
      >
        <attribute name="invisible" add="type == 'freetext'" separator="or" />
      </xpath>
    </field>
  </record>
</odoo>
