<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_qc_inspection_document_partner"
    inherit_id="quality_control_oca_inspection_report.report_qc_inspection_document"
  >
    <!-- With an explicit partner_id on the inspection, the "Customer" row can
         read it directly. Re-assign customer_record (a later t-set wins) to the
         inspection itself, so customer_record.partner_id resolves to
         doc.partner_id instead of digging through picking_id.sale_id / object_id. -->
    <xpath expr="//t[@t-set='customer_record']" position="after">
      <t t-set="customer_record" t-value="doc" />
    </xpath>
  </template>
</odoo>
