<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="qc_inspection_form_view_partner" model="ir.ui.view">
    <field name="name">qc.inspection.form.partner</field>
    <field name="model">qc.inspection</field>
    <field name="inherit_id" ref="quality_control_oca.qc_inspection_form_view" />
    <field name="arch" type="xml">
      <field name="test" position="before">
        <field name="partner_id" />
      </field>
    </field>
  </record>

  <record id="qc_inspection_tree_view_partner" model="ir.ui.view">
    <field name="name">qc.inspection.list.partner</field>
    <field name="model">qc.inspection</field>
    <field name="inherit_id" ref="quality_control_oca.qc_inspection_tree_view" />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="partner_id" optional="show" />
      </field>
    </field>
  </record>

  <record id="qc_inspection_search_view_partner" model="ir.ui.view">
    <field name="name">qc.inspection.search.partner</field>
    <field name="model">qc.inspection</field>
    <field name="inherit_id" ref="quality_control_oca.qc_inspection_search_view" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="partner_id" />
      </field>
      <filter name="group_by_product_id" position="after">
        <filter
          string="Partner"
          name="group_by_partner_id"
          domain="[]"
          context="{'group_by': 'partner_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
