<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="qc_inspection_form_view_sale" model="ir.ui.view">
    <field name="name">qc.inspection.form.sale.order</field>
    <field name="model">qc.inspection</field>
    <field name="inherit_id" ref="quality_control_oca.qc_inspection_form_view" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="sale_order_id" />
      </field>
    </field>
  </record>

  <record id="qc_inspection_tree_view_sale" model="ir.ui.view">
    <field name="name">qc.inspection.list.sale.order</field>
    <field name="model">qc.inspection</field>
    <field name="inherit_id" ref="quality_control_oca.qc_inspection_tree_view" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="sale_order_id" optional="show" />
      </field>
    </field>
  </record>

  <record id="qc_inspection_search_view_sale" model="ir.ui.view">
    <field name="name">qc.inspection.search.sale.order</field>
    <field name="model">qc.inspection</field>
    <field name="inherit_id" ref="quality_control_oca.qc_inspection_search_view" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="sale_order_id" />
      </field>
      <filter name="group_by_product_id" position="after">
        <filter
          string="Sale Order"
          name="group_by_sale_order_id"
          domain="[]"
          context="{'group_by': 'sale_order_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
