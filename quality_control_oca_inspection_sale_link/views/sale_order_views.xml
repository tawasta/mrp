<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="action_qc_inspection_from_sale_order" model="ir.actions.act_window">
    <field name="name">Quality inspections from sale order</field>
    <field name="res_model">qc.inspection</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('sale_order_id', '=', active_id)]</field>
    <field name="context">{}</field>
  </record>

  <record id="sale_order_form_qc_view" model="ir.ui.view">
    <field name="name">sale.order.form.qc.inspection</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form" />
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button
          class="oe_stat_button"
          type="action"
          name="%(action_qc_inspection_from_sale_order)d"
          icon="fa-check-square-o"
          groups="quality_control_oca.group_quality_control_user"
        >
          <field name="qc_inspection_count" widget="statinfo" string="Inspections" />
        </button>
      </div>
    </field>
  </record>
</odoo>
