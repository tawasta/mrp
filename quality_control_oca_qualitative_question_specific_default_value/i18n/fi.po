#. module: quality_control_oca_qualitative_question_specific_default_value
#: model:ir.model.fields,help:quality_control_oca_qualitative_question_specific_default_value.field_qc_test_question_value__is_default_qualitative_value
msgid ""
"If enabled, this answer is used to pre-fill the question instead of the "
"first correct answer found (requires 'Pre-fill with correct values' to be "
"enabled on the test)."
msgstr ""
"Jos käytössä, tätä vastausta käytetään kysymyksen esitäyttöön ensimmäisen "
"löytyvän oikean vastauksen sijaan (edellyttää, että testissä on käytössä "
"\"Esitäytä oikeilla arvoilla\")."

#. module: quality_control_oca_qualitative_question_specific_default_value
#. odoo-python
#: code:addons/quality_control_oca_qualitative_question_specific_default_value/models/qc_test_question_value.py:0
msgid "Only a correct answer can be set as the default pre-fill value."
msgstr "Vain oikea vastaus voidaan asettaa oletusarvoiseksi esitäyttövastaukseksi."

#. module: quality_control_oca_qualitative_question_specific_default_value
#. odoo-python
#: code:addons/quality_control_oca_qualitative_question_specific_default_value/models/qc_test_question_value.py:0
msgid "Only one answer can be set as the default pre-fill value per question."
msgstr ""
"Vain yksi vastaus per kysymys voidaan asettaa oletusarvoiseksi "
"esitäyttövastaukseksi."

#. module: quality_control_oca_qualitative_question_specific_default_value
