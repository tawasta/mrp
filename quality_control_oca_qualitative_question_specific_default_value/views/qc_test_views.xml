<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="qc_test_question_form_view" model="ir.ui.view">
    <field name="name">qc.test.question.form.inherit.default.qualitative.value</field>
    <field name="model">qc.test.question</field>
    <field name="inherit_id" ref="quality_control_oca.qc_test_question_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='ql_values']/list/field[@name='ok']" position="after">
        <field name="is_default_qualitative_value" />
      </xpath>
    </field>
  </record>
</odoo>
